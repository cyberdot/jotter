<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<WarnOn>3390;$(WarnOn)</WarnOn>
	</PropertyGroup>

	<!-- Theme files below are Content, not compiled resources: they must be copied next to the
	     executable so `jotter init <theme>` can find and copy them at runtime. -->
	<ItemDefinitionGroup>
		<Content>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemDefinitionGroup>

	<ItemGroup>
		<Compile Include="Program.fs" />
	</ItemGroup>

	<!-- The explicit per-file list this used to be had drifted out of sync with the files actually
	     on disk (e.g. several themes were listed with a stale .eex extension left over from the
	     Elixir port, while the real files are .cshtml), which went unnoticed because CopyToOutputDirectory
	     wasn't set. A single glob avoids that drift. -->
	<ItemGroup>
		<Content Include="themes\**\*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Jotter.Core\Jotter.Core.fsproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.CommandLine" Version="2.0.12" />
	</ItemGroup>

</Project>