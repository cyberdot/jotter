<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<WarnOn>3390;$(WarnOn)</WarnOn>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>jotter</ToolCommandName>
		<PackageId>Cyberdot.Jotter</PackageId>
		<Title>Jotter</Title>
		<Authors>cyberdot</Authors>
		<Description>Jotter is an F# static site generator for Markdown blogs with paginated indexes, tags, RSS, and themes.</Description>
		<PackageTags>static-site-generator;blog;markdown;fsharp;dotnet-tool</PackageTags>
		<RepositoryUrl>https://github.com/cyberdot/jotter</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<!-- Theme catalog and metadata ship next to the executable as content. Runtime discovery
	     is driven by themes.json, with only the selected theme copied into a new site. -->
	<ItemDefinitionGroup>
		<Content>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemDefinitionGroup>

	<ItemGroup>
		<Compile Include="Program.fs" />
	</ItemGroup>

	<!-- The explicit per-file list this used to be had drifted out of sync with the files actually
	     on disk (e.g. several themes were listed with a stale .eex extension left over from the
	     Elixir port, while the real files are .cshtml), which went unnoticed because CopyToOutputDirectory
	     wasn't set. A single glob avoids that drift. -->
	<ItemGroup>
		<Content Include="..\..\themes\**\*">
			<Link>themes\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
			<Pack>false</Pack>
		</Content>
		<Content Include="site_files\**\*" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Jotter.Core\Jotter.Core.fsproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.CommandLine" Version="2.0.12" />
	</ItemGroup>

</Project>